{
	"hooks": {
		"PreToolUse": [
			{
				"type": "command",
				"command": "node ./.github/hooks/deny-writes.js"
			}
		],
		"PostToolUse": [
			{
				"type": "command",
				"command": "./vendor/bin/pint"
			},
