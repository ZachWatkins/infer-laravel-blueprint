{
    "name": "zachwatkins/infer-laravel-blueprint",
    "description": "Infers the SQL column schema of a data source (CSV, JSON, XML, Excel, HTTP).",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.4",
        "doctrine/inflector": "^2.1",
        "flow-php/etl": "^0.43.0",
        "flow-php/etl-adapter-csv": "^0.43.0",
        "flow-php/etl-adapter-excel": "^0.43.0",
        "flow-php/etl-adapter-http": "^0.43.0",
        "flow-php/etl-adapter-json": "^0.43.0",
        "flow-php/etl-adapter-xml": "^0.43.0",
        "nyholm/psr7": "^1.8",
        "php-http/curl-client": "^2.2",
        "php-http/discovery": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "ZachWatkins\\InferLaravelBlueprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/infer-laravel-blueprint"
    ],
    "scripts": {
        "test": "pest",
        "test:build": [
            "@php scripts/build-test-fixtures-blueprint.php",
            "@php scripts/build-test-fixtures-sql.php"
        ],
        "lint": "pint --test --parallel --max-processes=4",
        "lint:fix": "pint --parallel --max-processes=4",
        "build": [
            "composer install --no-dev",
            "@php scripts/build-skill.php",
            "@php -d phar.readonly=0 scripts/build-phar.php",
            "composer install",
            "phpacker build"
        ],
        "build:readme": "php scripts/build-readme.php",
        "build:skill": "php scripts/build-skill.php",
        "install:skill": [
            "composer install --no-dev",
            "@php scripts/build-skill.php",
            "@php -d phar.readonly=0 scripts/build-phar.php",
            "composer install",
            "phpacker build",
            "@php scripts/install-skill.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/framework": "^13.31",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.7",
        "phpacker/phpacker": "^0.6.4",
        "phpoffice/phpspreadsheet": "^5.9"
    }
}
